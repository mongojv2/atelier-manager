# ==============================================================================
# ATELIER MANAGER - CONFIGURACIÓN DE VARIABLES DE ENTORNO (DESARROLLO)
# ==============================================================================
# Copia este archivo como .env para tu entorno local.
# NO incluyas credenciales reales ni contraseñas en este archivo plantilla.

# --- SERVIDOR Y ENTORNO ---
NODE_ENV="development"
PORT=3000
CORS_ORIGIN="*"

# --- BASE DE DATOS SQLITE CLOUD ---
# Cadena de conexión principal para la aplicación (Rol READWRITE recomendada)
SQLITE_CLOUD_CONNECTION_STRING="sqlitecloud://usuario:token@host.sqlite.cloud:8860/nombre_de_tu_db?apikey=TU_API_KEY_AQUI"

# Cadena de conexión administrativa para migración de esquemas DDL (npm run db:push)
SQLITE_CLOUD_ADMIN_CONNECTION_STRING="sqlitecloud://admin:token@host.sqlite.cloud:8860/nombre_de_tu_db?apikey=TU_API_KEY_ADMIN_AQUI"

# Omitir verificación automática de esquemas DDL en inicio del servidor (true | false)
SKIP_SCHEMA_BOOTSTRAP=false

# --- FRONTEND CLIENTE (VITE) ---
# URL base para peticiones API desde el cliente React.
# En desarrollo local se usa el proxy relativo '/api'. En producción puede ser la URL del backend (ej. https://api.ateliermanager.com/api)
VITE_API_BASE_URL="/api"

# ==============================================================================
# NOTA PARA PRODUCCIÓN (DEPLOYMENT):
# ==============================================================================
# Configura las siguientes variables en el panel de tu proveedor Cloud:
# NODE_ENV="production"
# PORT=8080 (o el asignado automáticamente)
# CORS_ORIGIN="https://tu-dominio-frontend.com"
# SQLITE_CLOUD_CONNECTION_STRING="sqlitecloud://prod_user:prod_token@host.sqlite.cloud:8860/nombre_de_tu_db?apikey=PROD_API_KEY"
# VITE_API_BASE_URL="https://tu-dominio-backend.com/api"

